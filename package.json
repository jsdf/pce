{
  "name": "pcejs",
  "description": "classic personal computer emulators for the browser",
  "keywords": [
    "emulator",
    "browserify"
  ],
  "author": "James Friend",
  "version": "0.1.0",
  "dependencies": {
    "browserify": "~4.1.5",
    "http-server": "^0.7.4",
    "xtend": "^4.0.0"
  },
  "licenses": [
    {
      "type": "GPL",
      "url": "https://raw.github.com/jsdf/pce/master/COPYING"
    }
  ],
  "devDependencies": {
    "@playwright/test": "1.48.2"
  },
  "scripts": {
    "prepublishOnly": "./pcejs_build",
    "clean": "./pcejs_build clean",
    "test": "npm run test:unit && npm run test:browser",
    "test:setup": "node test/setup.js",
    "test:unit": "node --test 'test/unit/**/*.test.js'",
    "test:browser": "playwright test"
  },
  "homepage": "https://github.com/jsdf/pce",
  "bugs": "https://github.com/jsdf/pce/issues",
  "repository": {
    "type": "git",
    "url": "git://github.com/jsdf/pce.git"
  }
}
